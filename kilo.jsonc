{
  "$schema": "https://app.kilo.ai/config.json",
  "model": "stg-litellm/training-2026-09-glm-5.3",
  "provider": {
    "stg-litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "СТГ LiteLLM",
      "options": {
        "baseURL": "https://ai-hub.carmoney.ru/litellm/v1"
      },
      "models": {
        "training-2026-09-minimax-m3": { "name": "MiniMax M3" },
        "training-2026-09-glm-5.3": { "name": "GLM 5.3" },
        "training-2026-09-gpt-5.6-terra": { "name": "GPT 5.6 Terra" }
      }
    }
  },
  "permission": {
    "read": { "*": "allow", "*.env*": "deny" },
    "edit": { "*": "allow", "*.env*": "deny", "kilo.jsonc": "deny" },
    "bash": { "*": "ask", "ast-index *": "allow", "git *": "allow", "git push*": "ask", "make *": "allow", "mkdir *": "allow", "printf *": "allow", "*.env*": "deny", "*reset_db*": "deny", "rm -rf*": "deny", "git push --force*": "deny" }
  },
  "instructions": [
    "~/.config/kilo/rules/ast-index.md",
    "~/.config/kilo/rules/caveman-output.md"
  ],
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true
    }
  }
}
