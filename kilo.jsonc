{
  "$schema": "https://app.kilo.ai/config.json",
  "instructions": [
    "/Users/neuradev/.config/kilo/rules/ast-index.md",
    "/Users/neuradev/.config/kilo/rules/caveman.md"
  ],
  "mcp": {
    "caveman": {
      "type": "local",
      "command": ["/Users/neuradev/.caveman/bin/caveman-mcp"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": true
    }
  },
  "model": "stg-litellm/training-2026-09-glm-5.3",
  "provider": {
    "stg-litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "СТГ LiteLLM",
      "options": {
        "baseURL": "https://ai-hub.carmoney.ru/litellm/v1"
      },
      "models": {
        "training-2026-09-minimax-m3": { "name": "MiniMax M3" },
        "training-2026-09-glm-5.3": { "name": "GLM 5.3" },
        "training-2026-09-gpt-5.6-terra": { "name": "GPT 5.6 Terra" }
      }
    }
  },
  "permission": {
    "bash": {
      "mkdir *": "allow",
      "printf *": "allow"
    }
  }
}